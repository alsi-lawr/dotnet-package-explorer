<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AssemblyName>dotnet-pe</AssemblyName>
        <RootNamespace>Dotnet.PackageExplorer.Terminal</RootNamespace>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>dotnet-pe</ToolCommandName>
        <PackageId>ALSI.PackageExplorer</PackageId>
        <Version>0.1.0</Version>
        <Title>dotnet-pe</Title>
        <Description>Explore and manage NuGet packages from a terminal.</Description>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/alsi-lawr/dotnet-package-explorer</PackageProjectUrl>
        <RepositoryUrl>https://github.com/alsi-lawr/dotnet-package-explorer.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageTags>dotnet;nuget;packages;terminal;tui;tool</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageReadmeSource>$(MSBuildProjectDirectory)/../../README.md</PackageReadmeSource>
        <PackageReadmeOutput>$(MSBuildProjectExtensionsPath)package/README.md</PackageReadmeOutput>
        <PackageReadmeGenerator>$(MSBuildProjectDirectory)/../../scripts/PackageReadme.fsx</PackageReadmeGenerator>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="AssemblyInfo.fs" />
        <Compile Include="Presentation.fs" />
        <Compile Include="Theme.fs" />
        <Compile Include="Keyboard.fs" />
        <Compile Include="Renderer.fs" />
        <Compile Include="Runtime.fs" />
        <Compile Include="Program.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Application/Dotnet.PackageExplorer.Application.fsproj" />
        <ProjectReference Include="../RpcClient/Dotnet.PackageExplorer.RpcClient.fsproj" />
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="Terminal.Gui" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(PackageReadmeOutput)" Pack="true" PackagePath="/" />
        <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    </ItemGroup>

    <Target
        Name="GeneratePackageReadme"
        BeforeTargets="GenerateNuspec"
        Inputs="$(PackageReadmeSource);$(PackageReadmeGenerator)"
        Outputs="$(PackageReadmeOutput)">
        <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(PackageReadmeOutput)'))" />
        <Exec
            Command="dotnet fsi &quot;$(PackageReadmeGenerator)&quot; &quot;$(PackageReadmeSource)&quot; &quot;$(PackageReadmeOutput)&quot;" />
    </Target>
</Project>
