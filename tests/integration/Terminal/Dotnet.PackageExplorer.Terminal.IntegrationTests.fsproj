<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <OutputType>Exe</OutputType>
        <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
        <AssemblyName>Dotnet.PackageExplorer.Terminal.IntegrationTests</AssemblyName>
        <RootNamespace>Dotnet.PackageExplorer.Terminal.IntegrationTests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="../../unit/Terminal/TestData.fs" Link="TestData.fs" />
        <Compile Include="AnsiDriverTests.fs" />
        <Compile Include="InteractionTests.fs" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference
            Include="../../../src/Terminal/Dotnet.PackageExplorer.Terminal.fsproj"
        />
        <PackageReference Include="FSharp.Core" />
        <PackageReference Include="FsUnit.Xunit" />
        <PackageReference Include="xunit.v3" />
    </ItemGroup>
</Project>
